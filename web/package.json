{
  "name": "chaingauge-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "tsx scripts/gen-ratings.ts",
    "build": "tsc -b && vite build",
    "gen:ratings": "tsx scripts/gen-ratings.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "design:check": "node scripts/design-check.mjs",
    "check:api": "tsc -p tsconfig.api.json",
    "gates": "npm run lint && npm test && npm run prose && npm run source:check && npm run check:api && npm run build && npm run design:check",
    "prose": "node scripts/prose-check.mjs --fail",
    "gen:icons": "node ../tools/gen-icons.mjs",
    "source:check": "node scripts/source-check.mjs",
    "link:check": "node scripts/link-check.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@web3icons/core": "^4.0.53",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.8"
  }
}
